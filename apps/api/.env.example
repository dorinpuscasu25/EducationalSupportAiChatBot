# Settings for running the API directly (`make api-dev`). With Docker Compose
# the root .env is used instead.

ENV=development
SERVER_PORT=3380
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-chars
CORS_ALLOWED_ORIGINS=http://localhost:5173

DB_HOST=127.0.0.1
DB_PORT=5433
DB_USER=academy
DB_PASSWORD=academy
DB_NAME=academy
DB_SSLMODE=disable
DB_TIMEZONE=Europe/Chisinau

# First administrator, created at startup if the email does not exist yet.
ADMIN_EMAIL=admin@academie.test
ADMIN_PASSWORD=Admin-local-2026!

# Folder with the course materials (relative to apps/api).
DOCUMENTS_DIR=../../documents

# LLM (OpenAI-compatible). Without a key the chat runs in demo mode.
OPENAI_API_KEY=
OPENAI_API_BASE_URL=https://api.openai.com/v1
CHAT_LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

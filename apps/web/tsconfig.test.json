{
  // Unit tests and their harness. A project of their own so Node's types
  // (node:assert, node:fs, Buffer) are available to tests without leaking into
  // app code, which tsconfig.app.json keeps browser-only.
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.test.tsbuildinfo",
    "types": ["vite/client", "node"]
  },
  "include": ["src/**/*.test.ts", "src/**/*.test.tsx", "src/test", "src/**/*.d.ts"],
  // Override the app project's exclude, which is what keeps tests out of it.
  "exclude": []
}

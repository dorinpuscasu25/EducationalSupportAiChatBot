# Browser URL of the API, without a trailing slash. Vite proxies /api in development.
VITE_API_URL=/api
# Where the dev server proxies /api (the API started with `make api-dev` or Docker).
VITE_DEV_API_TARGET=http://127.0.0.1:3380
# Branding (optional).
VITE_APP_NAME=Asistent Academie
VITE_ACADEMY_NAME=Academia

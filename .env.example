# ─── Asistent Academie — configuration for docker compose ───────────────────
# Copy to .env and fill in. Never commit .env.

# Public port of the web app (http://localhost:8080).
WEB_PORT=8080

# Branding shown in the interface.
APP_NAME=Asistent Academie
ACADEMY_NAME=Academia
# Public URL of the platform, used in emails.
APP_PUBLIC_URL=http://localhost:8080

# ── Security ────────────────────────────────────────────────────────────────
# development | production. In production SMTP/Resend and HTTPS CORS are required.
ENV=development
# Random string, at least 32 characters (e.g. `openssl rand -hex 32`).
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-chars
# Only needed when the browser calls the API from another origin.
CORS_ALLOWED_ORIGINS=

# First administrator, created at startup if this email does not exist yet.
ADMIN_EMAIL=admin@academie.test
ADMIN_PASSWORD=Admin-local-2026!

# ── Database ────────────────────────────────────────────────────────────────
POSTGRES_USER=academy
POSTGRES_PASSWORD=academy
POSTGRES_DB=academy

# ── AI model (OpenAI-compatible: OpenAI, Gemini AI Studio, OpenRouter…) ──────
# Without a key the chat runs in demo mode: it shows the passages it found.
OPENAI_API_KEY=
OPENAI_API_BASE_URL=https://api.openai.com/v1
CHAT_LLM_MODEL=gpt-4o-mini
CHAT_MAX_TOKENS=1500
# Send attached images to the model (needs a vision model, e.g. gpt-4o-mini).
CHAT_VISION=true

# Embeddings for semantic search (same key by default). Changing the model or
# dimension re-indexes every document automatically.
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
# EMBEDDING_API_URL=
# EMBEDDING_API_KEY=

# ── Retrieval ───────────────────────────────────────────────────────────────
RAG_TOP_K=6
RAG_MAX_CHUNKS_PER_DOC=3
RAG_MIN_SIMILARITY=0.25
# Re-read the documents folder periodically (e.g. 30m); empty = only at
# startup and from the admin panel.
KNOWLEDGE_SYNC_INTERVAL=
# OCR for scanned PDFs (tesseract languages).
OCR_LANGUAGES=ron+eng+rus

# ── Email (one of the two; in development codes are written to the API log) ─
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=Asistent Academie <no-reply@example.com>

# ── Limits ──────────────────────────────────────────────────────────────────
CHAT_RATE_LIMIT_PER_MINUTE=20
